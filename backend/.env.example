# ─────────────────────────────────────────────────────────────────────────────
# Glowbook API — environment variables.
# Copy to `.env` for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection — used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth — at least 32 random characters: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
AUTH_SECRET="replace-with-a-long-random-string"

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/reminders.
CRON_SECRET="replace-with-another-random-string"

# Public URLs
API_BASE_URL="https://your-api.vercel.app"
APP_BASE_URL="https://your-app.vercel.app"          # Flutter web app (used in reset-password links)
CORS_ORIGINS="https://your-app.vercel.app"          # comma-separated origins allowed to call the API

# Payments — "test" enables the sandbox gateway (no money moves). Leave empty in production
# until a real gateway (e.g. Thawani, Stripe) is implemented in src/server/payments/service.ts.
PAYMENT_PROVIDER="test"

# Social sign-in (comma-separated OAuth client IDs whose ID tokens we accept)
GOOGLE_CLIENT_IDS=""
APPLE_CLIENT_IDS=""

# Push — Firebase Cloud Messaging (service account)
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""                                   # keep the \n escapes

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Email — Resend
RESEND_API_KEY=""
EMAIL_FROM="Glowbook <bookings@yourdomain.com>"

# SMS — Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Optional
DB_POOL_MAX="5"
